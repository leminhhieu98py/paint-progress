# Required to run tests/rls.integration.test.ts (npx vitest run tests/rls.integration.test.ts).
# Without this file, that suite reports as skipped rather than failing.
#
# Run order, in full, before the suite can pass:
#   1. In the Supabase dashboard, create all three auth accounts: the
#      bootstrap admin (username `linhdeptrai123`, see supabase/README.md),
#      the test GS (`rlstest-gs`) and the test admin (`rlstest-admin`).
#      Passwords of your choice -- put them below.
#      Then give `rlstest-admin` a profiles row with role = 'admin':
#      `insert into profiles (id, username, full_name, role) select id,
#      'rlstest-admin', 'RLS Test Admin', 'admin' from auth.users where
#      email = 'rlstest-admin@app.local';`
#      Choose its password with care: an admin account can read every GS
#      password through the admin-users Edge Function. Use a long random
#      string, not a memorable one.
#   2. nvm use 22 && npx supabase db query --linked -f tests/rls-fixtures.sql
#      Every returned row must say PASS. A FAIL means one of the accounts
#      above is missing or misconfigured -- fix that and re-run this script
#      before trusting any test result.
#   3. Copy this file to .env.test.local (gitignored) and fill in the
#      values below.
#   4. After each run of the suite against a live project:
#      npx supabase db query --linked -f tests/rls-teardown.sql
#      The suite's own afterAll hooks cannot delete the auth users its Edge
#      Function tests create, nor the credential_access_log rows they write.
#      Every returned row must say PASS.
#
# Nothing in this file is committed. Never paste a password into a tracked
# file, an error message, a test assertion or a report -- one of this
# project's real incidents was a test password reaching a git-tracked file.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
RLS_TEST_GS_USERNAME=rlstest-gs
RLS_TEST_GS_PASSWORD=
RLS_TEST_ADMIN_USERNAME=rlstest-admin
RLS_TEST_ADMIN_PASSWORD=
# The project ref the suite (and its teardown) may touch. The teardown refuses
# to run when `supabase link` points anywhere else -- the linked project is
# sometimes PROD, right after a migration push.
RLS_TEST_PROJECT_REF=

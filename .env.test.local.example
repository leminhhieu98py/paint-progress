# Required to run tests/rls.integration.test.ts (npx vitest run tests/rls.integration.test.ts).
# Without this file, that suite reports as skipped rather than failing.
#
# Run order, in full, before the suite can pass:
#   1. In the Supabase dashboard, create both auth accounts: the bootstrap
#      admin (username `linhdeptrai123`, see supabase/README.md) and the
#      test GS (username `rlstest-gs`, password of your choice -- put it
#      below).
#   2. nvm use 22 && npx supabase db query --linked -f tests/rls-fixtures.sql
#      Every returned row must say PASS. A FAIL means one of the two
#      accounts above is missing or misconfigured -- fix that and re-run
#      this script before trusting any test result.
#   3. Copy this file to .env.test.local (gitignored) and fill in the
#      values below.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
RLS_TEST_GS_USERNAME=rlstest-gs
RLS_TEST_GS_PASSWORD=
